QLabel {
  
    font-family: sans-serif;
    color: #333333; 
    font-weight: normal;
    letter-spacing: 1px;
}

/* Sidebar Styling */
#sidebar {
    background-color: #FAFAFA;
    border: 1px solid #474747;
}

QFrame {
    border: 1px solid #474747;
    /* border: none;  */
    background-color: #F7F7F7;  /* Optional background color */
    padding: 5px;  /* Adjust padding if needed */
}


#taskFrame {
    border-radius: 10px;
}

/* Sidebar Buttons */
/* QPushButton {
    background-color: transparent;
    border: none;
} */

QPushButton:hover {
    background-color: rgba(71, 71, 71, 0.2);
    border-radius: 10px;
}

QPushButton:pressed {
    background-color: rgba(71, 71, 71, 0.4);
}

/* Dashboard Styling */
 #homePage, #collectionPage, #statsPage, #notification, #communityPage {
    background-color: #F6F0F0;
}


QScrollArea {
    background: #F8F6F1;
    border: none;
    margin: 1;
    padding: 1;
}

